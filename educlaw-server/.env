# ============================================================
# EduClaw Server — environment configuration
# Copy to the working directory before running educlaw-server.
# Lines starting with # are comments — uncomment to activate.
# ============================================================

# ── Server ───────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:8080

# ── Security ─────────────────────────────────────────────────
# Signing secret for all JWTs. Keep this private.
JWT_SECRET=15a610c6fa0c44c871d62b3cb3db760c0f1d41cd3780e35b481bc342687ada52

# Admin token secret for POST /auth/token (dev tooling only).
# Set to something random; leave unset to disable the endpoint.
ADMIN_SECRET=change-me-admin-secret

# ── Database ──────────────────────────────────────────────────
# SQLite file — created automatically on first run.
DATABASE_URL=sqlite:///var/lib/educraw/educraw.db?mode=rwc

# ── Paths ─────────────────────────────────────────────────────
# Where session overlays (upper/work/merged) are stored.
EDUCLAW_WORKSPACE_ROOT=/var/lib/educraw/sessions

# ── fuse-overlayfs (required for session isolation) ──────────────────────
# Install:  sudo apt install fuse-overlayfs
#
# If you get "Operation not permitted" after installing, run these once:
#   sudo sysctl -w kernel.unprivileged_userns_clone=1          # Debian/Ubuntu
#   echo 'kernel.unprivileged_userns_clone=1' | sudo tee /etc/sysctl.d/99-educlaw.conf
#   sudo usermod -aG fuse $(whoami) && newgrp fuse              # add user to fuse group
#   echo 'user_allow_other' | sudo tee -a /etc/fuse.conf        # allow user mounts
#
# Reboot or re-login after usermod for group change to take effect.

# Absolute path to the educlaw-plugin folder.
EDUCLAW_PLUGIN_PATH=/srv/educlaw/educlaw-plugin

# Path to the compiled claw (Claude Code) binary.
CLAW_BIN=/srv/educlaw/claw


# Path to the jail tools directory (custom static busybox, mounted into jail as /tools/).
JAIL_TOOLS_HOST=/srv/educraw/jail-tools

# Where the built React frontend is served from.
EDUCLAW_WEB_ROOT=/srv/educlaw/educlaw-web/dist

# Subject materials (read-only lower layer for OverlayFS).
# Layout: {root}/{cohort_id}/{slug}/, e.g. /srv/educlaw/data/subjects/primary-2b/mathematics/
EDUCLAW_SUBJECTS_ROOT=/srv/educlaw/data/subjects

# Per-student writable upper layers.
EDUCLAW_STUDENTS_ROOT=/var/lib/educraw/students

# ── cgroups v2 per-session resource limits ────────────────────
# Cgroup delegation directory. The server creates session-{id}/ subdirs here.
# Must match the directory created by setup-systemd.sh.
EDUCRAW_CGROUP_ROOT=/sys/fs/cgroup/educraw

# Memory cap per session (bytes). Default: 512 MiB.
EDUCLAW_CGROUP_MEMORY_MAX=536870912

# CPU quota: "used_microseconds period_microseconds" per scheduling window.
# Default: 50 % of one CPU core.
EDUCLAW_CGROUP_CPU_MAX="50000 100000"

# Max processes/threads per session.
EDUCLAW_CGROUP_PIDS_MAX=256

# ── Session watchdog ──────────────────────────────────────────
# Seconds of keyboard inactivity before session is terminated.
# EDUCLAW_IDLE_TIMEOUT_S=900

# Warn the student this many seconds before hard disconnect.
# EDUCLAW_WARN_BEFORE_S=60

# ── LLM provider API keys ─────────────────────────────────────

XAI_API_KEY=xai-Q3T4qBJUCfqzHmOllqUt6oNiw8iGfsurmFWlIfsLgiN4iXva8RJHFHoHFMD0SYyWL6vWPiIelS69IGUl

ANTHROPIC_API_KEY=abc

OPENAI_API_KEY=abc

GOOGLE_API_KEY=abc

OPENROUTER_API_KEY=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

DEEPSEEK_API_KEY=sk-3e794ed9ddfc423481cbfd3042dd6526

GROQ_API_KEY=abc

MISTRAL_API_KEY=abc

MOONSHOT_API_KEY=abc

MINIMAX_API_KEY=abc

NOVITA_API_KEY=abc

NVIDIA_API_KEY=abc

CEREBRAS_API_KEY=abc

INCEPTION_API_KEY=abc

OLLAMA_CLOUD_API_KEY=abc

ZHIPU_API_KEY=abc

TANZU_AI_API_KEY=abc

TENSORIX_API_KEY=abc

OVHCLOUD_API_KEY=abc


OPENAI_BASE_URL=http//abc

CLAW_MODEL=grok-3

# Goose traversal exclusions (used by tree/analyze/summarize guards in Goose)
GOOSE_EXCLUDED_DIRS=/proc,/dev,/sys,/run

# Per-student disk quota in bytes (0 = unlimited). Default: 500 MiB.
EDUCRAW_STUDENT_QUOTA_BYTES=524288000


# ── MCP / embedding ──────────────────────────────────────────
# URL the MCP server uses to call the embedding service.
# Run a small sentence-transformers server on this port.
EMBEDDING_API_URL=http://127.0.0.1:8181

# Dimensions of the embedding model (must match your model).
# 384 = MiniLM-L6-v2  |  768 = BGE-base  |  1536 = OpenAI ada-002
EMBEDDING_DIM=384

# Path to the LanceDB search index used by educlaw-mcp.
EDUCLAW_SEARCH_DB=/var/lib/educraw/educraw-search.db

# URL educlaw-mcp uses to call back into educlaw-server.
EDUCLAW_SERVER_URL=http://127.0.0.1:8080
