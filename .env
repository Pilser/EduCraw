# ============================================================
# EduClaw Server — environment configuration
# Goose-based AI engine (Minimized)
# ============================================================

# ── Server ───────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:8000

# ── Security ─────────────────────────────────────────────────
# Signing secret for all JWTs. Keep this private.
JWT_SECRET=15a610c6fa0c44c871d62b3cb3db760c0f1d41cd3780e35b481bc342687ada52

# Admin token secret for POST /auth/token (dev tooling only).
# Set to something random; leave unset to disable the endpoint.
ADMIN_SECRET=change-me-admin-secret

# ── Database ──────────────────────────────────────────────────
# SQLite file — created automatically on first run.
DATABASE_URL=sqlite:///var/lib/educraw/educraw.db?mode=rwc

# ── Paths ─────────────────────────────────────────────────────
# Where session overlays (upper/work/merged) are stored.
EDUCLAW_WORKSPACE_ROOT=/var/lib/educraw/sessions

# Subject materials (read-only lower layer for OverlayFS).
# Layout: {root}/{cohort_id}/{slug}/, e.g. /srv/educlaw/data/subjects/primary-2b/mathematics/
EDUCLAW_SUBJECTS_ROOT=/srv/educraw/data/subjects

# Common binaries shared across all sessions (goose, etc.)
# This directory is added as the bottom layer of OverlayFS so all students see it.
# Put goose binary here: {root}/bin/goose
EDUCLAW_COMMON_ROOT=/var/lib/educraw/common

# Student persistent home (OverlayFS upper layer).
# Layout: {root}/{student_id}/
# Each student gets their own directory for persistent data, config, and logs.
EDUCLAW_STUDENTS_ROOT=/var/lib/educraw/students

# ── Goose AI Engine ──────────────────────────────────────────
# Path to the goose binary (shared across all sessions via OverlayFS).
# Students see this as /bin/goose after chroot.
GOOSE_BIN=/var/lib/educraw/common/bin/goose

# Default LLM model for all sessions. Can be overridden per-session.
# Examples: claude-3-5-sonnet-20241022, gpt-4o, gpt-4-turbo
# If not set, goose uses its configured default.
# GOOSE_MODEL=claude-3-5-sonnet-20241022

# ── LLM Provider Keys ────────────────────────────────────────
# At least ONE of these must be set for goose to work.
# Uncomment and set based on which provider(s) you use.

# Anthropic Claude API
# Get key from: https://console.anthropic.com
XAI_API_KEY=xai-Q3T4qBJUCfqzHmOllqUt6oNiw8iGfsurmFWlIfsLgiN4iXva8RJHFHoHFMD0SYyWL6vWPiIelS69IGUl

# OpenAI (GPT-4, GPT-4o, etc.)
# Get key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Google Gemini
# Get key from: https://aistudio.google.com
# GEMINI_API_KEY=...

# Other providers (optional)
# GROQ_API_KEY=...
# MISTRAL_API_KEY=...
# GOOGLE_API_KEY=...

# OpenAI-compatible API base URL (if using a proxy or local inference)
# OPENAI_BASE_URL=http://localhost:8000

# ── fuse-overlayfs (required for session isolation) ──────────────────────
# Install: sudo apt install fuse-overlayfs
#
# If you get "Operation not permitted" after installing, run these once:
#   sudo sysctl -w kernel.unprivileged_userns_clone=1          # Debian/Ubuntu
#   echo 'kernel.unprivileged_userns_clone=1' | sudo tee /etc/sysctl.d/99-educraw.conf
#   sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0   # Ubuntu 24.04+
#   echo 'kernel.apparmor_restrict_unprivileged_userns=0' | sudo tee /etc/sysctl.d/99-educraw-unpriv.conf
#   sudo usermod -aG fuse $(whoami) && newgrp fuse              # add user to fuse group
#   echo 'user_allow_other' | sudo tee -a /etc/fuse.conf        # allow user mounts
#
# Reboot or re-login after usermod for group change to take effect.

# ── cgroups v2 resource limits per session ────────────────────────────────
# Memory limit per session (bytes). Default: 512 MiB (536870912)
EDUCLAW_CGROUP_MEMORY_MAX=536870912

# CPU quota (microseconds). Default: 50% of one core (50000 out of 100000 us)
EDUCLAW_CGROUP_CPU_MAX="50000 100000"

# Max processes per session. Default: 256
EDUCLAW_CGROUP_PIDS_MAX=256

# ── Frontend ──────────────────────────────────────────────────
# Where the built React frontend is served from.
EDUCLAW_WEB_ROOT=/srv/educraw/bin/web-ui/dist
