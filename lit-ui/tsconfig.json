{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "paths": {
      "@earendil-works/pi-agent-core": ["../pi/packages/agent/dist/index.d.ts"],
      "@earendil-works/pi-ai": ["../pi/packages/ai/dist/index.d.ts"],
      "@earendil-works/pi-web-ui": ["../pi/packages/web-ui/dist/index.d.ts"],
    },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "outDir": "./dist",
    "rootDir": "./src",
  },
  "include": ["src/**/*"],
}
