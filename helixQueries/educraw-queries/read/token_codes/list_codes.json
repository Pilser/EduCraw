{
  "request_type": "read",
  "query": {
    "queries": [
      {
        "Query": {
          "name": "codes",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "TokenCode"}]}},
            {"Where": {"Compare": {"left": {"Property": "tokens"}, "op": "Eq", "right": {"Param": "tokens"}}}},
            {"OrderBy": ["created_at", "Desc"]},
            {"Limit": 500},
            {"ValueMap": null}
          ],
          "condition": {"VarNotEmpty": "tokens_filter"}
        }
      },
      {
        "Query": {
          "name": "codes_all",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "TokenCode"}]}},
            {"OrderBy": ["created_at", "Desc"]},
            {"Limit": 500},
            {"ValueMap": null}
          ],
          "condition": {"VarEmpty": "tokens_filter"}
        }
      },
      {
        "Query": {
          "name": "codes_used",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "TokenCode"}]}},
            {"Where": {"And": [
              {"Compare": {"left": {"Property": "tokens"}, "op": "Eq", "right": {"Param": "tokens"}}},
              {"IsNotNull": "used_by"}
            ]}},
            {"OrderBy": ["created_at", "Desc"]},
            {"Limit": 500},
            {"ValueMap": null}
          ],
          "condition": {"VarNotEmpty": "show_used"}
        }
      },
      {
        "Query": {
          "name": "codes_unused",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "TokenCode"}]}},
            {"Where": {"And": [
              {"Compare": {"left": {"Property": "tokens"}, "op": "Eq", "right": {"Param": "tokens"}}},
              {"IsNull": "used_by"}
            ]}},
            {"OrderBy": ["created_at", "Desc"]},
            {"Limit": 500},
            {"ValueMap": null}
          ],
          "condition": {"VarNotEmpty": "show_unused"}
        }
      }
    ],
    "returns": ["codes", "codes_all", "codes_used", "codes_unused"]
  },
  "parameters": {
    "tokens": 0,
    "tokens_filter": "",
    "show_used": "",
    "show_unused": ""
  },
  "parameter_types": {
    "tokens": "I64",
    "tokens_filter": "String",
    "show_used": "String",
    "show_unused": "String"
  }
}
