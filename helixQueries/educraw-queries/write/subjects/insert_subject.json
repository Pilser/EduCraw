{
  "request_type": "write",
  "query": {
    "queries": [
      {
        "Query": {
          "name": "subject",
          "steps": [
            {"AddN": {
              "label": "Subject",
              "properties": [
                ["id", {"Expr": {"Param": "id"}}],
                ["slug", {"Expr": {"Param": "slug"}}],
                ["title", {"Expr": {"Param": "title"}}],
                ["cohort_id", {"Expr": {"Param": "cohort_id"}}]
              ]
            }}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "cohort",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Cohort"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "cohort_id"}}}}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "link",
          "steps": [
            {"N": {"Var": "cohort"}},
            {"AddE": {
              "label": "HAS_SUBJECT",
              "to": {"Var": "subject"},
              "properties": []
            }}
          ],
          "condition": {"VarNotEmpty": "cohort"}
        }
      }
    ],
    "returns": ["subject"]
  },
  "parameters": {
