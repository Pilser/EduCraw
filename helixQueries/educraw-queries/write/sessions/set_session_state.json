{
  "request_type": "write",
  "query": {
    "queries": [
      {
        "Query": {
          "name": "session",
          "steps": [
            {
              "NWhere": {
                "Eq": [
                  "$label",
                  {
                    "String": "Session"
                  }
                ]
              }
            },
            {
              "Where": {
                "Compare": {
                  "left": {
                    "Property": "id"
                  },
                  "op": "Eq",
                  "right": {
                    "Param": "session_id"
                  }
                }
              }
            },
            {
              "SetProperty": [
                "state",
                {
                  "Expr": {
                    "Param": "state"
                  }
                }
              ]
            },
            {
              "Choose": {
                "condition": {
                  "Eq": [
                    "state",
                    {
                      "String": "ended"
                    }
                  ]
                },
                "then_traversal": {
                  "steps": [
                    {
                      "SetProperty": [
                        "ended_at",
                        {
                          "Expr": "Timestamp"
                        }
                      ]
                    }
                  ]
                },
                "else_traversal": null
              }
            }
          ],
          "condition": null
        }
      }
    ],
    "returns": [
      "session"
    ]
  },
  "parameters": {
    "session_id": "",
    "state": "active"
  },
  "parameter_types": {
    "session_id": "String",
    "state": "String"
  }
}
