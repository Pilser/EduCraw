{
  "request_type": "write",
  "query": {
    "queries": [
      {
        "Query": {
          "name": "session",
          "steps": [
            {"AddN": {
              "label": "Session",
              "properties": [
                ["id", {"Expr": {"Param": "id"}}],
                ["student_id", {"Expr": {"Param": "student_id"}}],
                ["state", {"Expr": {"Param": "state"}}],
                ["overlay_mount", {"Expr": {"Param": "overlay_mount"}}],
                ["model", {"Expr": {"Param": "model"}}],
                ["last_token_checkpoint", {"Value": {"I64": 0}}],
                ["started_at", {"Expr": {"Param": "started_at"}}]
              ]
            }}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "student_node",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Student"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "student_id"}}}},
            {"SetProperty": ["last_seen", {"Expr": {"Param": "last_seen"}}]}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "link",
          "steps": [
            {"N": {"Var": "session"}},
            {"AddE": {
              "label": "HAS_SESSION",
              "to": {"Var": "student_node"},
              "properties": []
            }}
          ],
          "condition": {"VarNotEmpty": "student_node"}
        }
      }
    ],
    "returns": ["session", "student_node"]
  },
  "parameters": {
    "id": "",
    "student_id": "",
    "cohort_id": "",
    "state": "active",
    "overlay_mount": "",
    "model": "",
    "started_at": "",
    "last_seen": ""
  },
  "parameter_types": {
    "id": "String",
    "student_id": "String",
    "cohort_id": "String",
    "state": "String",
    "overlay_mount": "String",
    "model": "String",
    "started_at": "String",
    "last_seen": "String"
  }
}
