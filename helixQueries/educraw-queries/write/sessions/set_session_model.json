{
  "request_type": "write",
  "query": {
    "queries": [
      {
        "Query": {
          "name": "session",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Session"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "session_id"}}}},
            {"SetProperty": ["model", {"Expr": {"Param": "model_name"}}]}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "old_model",
          "steps": [
            {"N": {"Var": "session"}},
            {"Out": "USED_MODEL"}
          ],
          "condition": {"VarNotEmpty": "session"}
        }
      },
      {
        "Query": {
          "name": "drop_old",
          "steps": [
            {"N": {"Var": "session"}},
            {"DropEdgeLabeled": {"to": {"Var": "old_model"}, "label": "USED_MODEL"}}
          ],
          "condition": {"VarNotEmpty": "old_model"}
        }
      },
      {
        "Query": {
          "name": "model",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Model"}]}},
            {"Where": {"Compare": {"left": {"Property": "name"}, "op": "Eq", "right": {"Param": "model_name"}}}}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "link",
          "steps": [
            {"N": {"Var": "session"}},
            {"AddE": {
              "label": "USED_MODEL",
              "to": {"Var": "model"},
              "properties": []
            }}
          ],
          "condition": {"VarNotEmpty": "model"}
        }
      }
    ],
    "returns": ["session"]
  },
  "parameters": {
    "session_id": "",
    "model_name": ""
  },
  "parameter_types": {
    "session_id": "String",
    "model_name": "String"
  }
}
