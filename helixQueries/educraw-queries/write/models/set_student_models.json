{
  "request_type": "write",
  "query": {
    "queries": [
      {
        "Query": {
          "name": "student",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Student"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "student_id"}}}}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "old_models",
          "steps": [
            {"N": {"Var": "student"}},
            {"Out": "ALLOWED_MODEL"}
          ],
          "condition": {"VarNotEmpty": "student"}
        }
      },
      {
        "Query": {
          "name": "drop_old",
          "steps": [
            {"N": {"Var": "student"}},
            {"DropEdgeLabeled": {"to": {"Var": "old_models"}, "label": "ALLOWED_MODEL"}}
          ],
          "condition": {"VarNotEmpty": "old_models"}
        }
      },
      {
        "ForEach": {
          "param": "models",
          "body": [
            {
              "Query": {
                "name": "model",
                "steps": [
                  {"NWhere": {"Eq": ["$label", {"String": "Model"}]}},
                  {"Where": {"Compare": {"left": {"Property": "name"}, "op": "Eq", "right": {"Param": "name"}}}}
                ],
                "condition": null
              }
            },
            {
              "Query": {
                "name": "link",
                "steps": [
                  {"N": {"Var": "student"}},
                  {"AddE": {
                    "label": "ALLOWED_MODEL",
                    "to": {"Var": "model"},
                    "properties": []
                  }}
                ],
                "condition": {"VarNotEmpty": "model"}
              }
            }
          ]
        }
      }
    ],
    "returns": ["student"]
  },
  "parameters": {
    "student_id": "",
    "models": []
  },
  "parameter_types": {
    "student_id": "String",
    "models": {"Array": "Object"}
  }
}
