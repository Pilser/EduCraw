                  {"AddE": {
                    "label": "ALLOWED_MODEL",
                    "to": {"NWhere": {"And": [
                      {"Eq": ["$label", {"String": "Model"}]},
                      {"Compare": {"left": {"Property": "name"}, "op": "Eq", "right": {"Param": "name"}}}
                    ]}},
                    "properties": []
                  }}
                ],
                "condition": null
              }
            }
          ]
        }
      }
    ],
    "returns": ["student", "edge"]
  },
  "parameters": {
