{
  "request_type": "write",
  "query": {
    "queries": [
      {
        "Query": {
          "name": "student",
          "steps": [
            {"N": {"Param": "student_id"}},
            {"DropEdgeLabeled": {"to": {"NWhere": {"Eq": ["$label", {"String": "Model"}]}}, "label": "ALLOWED_MODEL"}}
          ],
          "condition": null
