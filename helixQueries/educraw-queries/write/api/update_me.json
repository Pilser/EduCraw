{
  "request_type": "write",
  "query": {
    "queries": [
      {
        "Query": {
          "name": "student",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Student"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "student_id"}}}},
            {"Choose": {
              "condition": {"VarNotEmpty": "display_name"},
              "then_traversal": {"steps": [
                {"SetProperty": ["display_name", {"Expr": {"Param": "display_name"}}]}
              ]},
              "else_traversal": null
            }},
            {"Choose": {
              "condition": {"VarNotEmpty": "password_hash"},
              "then_traversal": {"steps": [
                {"SetProperty": ["password_hash", {"Expr": {"Param": "password_hash"}}]}
              ]},
              "else_traversal": null
            }},
            {"SetProperty": ["cohort_id", {"Expr": {"Param": "cohort_id"}}]}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "old_cohort_edge",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Student"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "student_id"}}}},
            {"DropEdgeLabeled": {"to": {"NWhere": {"Eq": ["$label", {"String": "Cohort"}]}}, "label": "IN_COHORT"}}
          ],
          "condition": {"VarNotEmpty": "cohort_id"}
        }
      },
      {
        "Query": {
          "name": "new_cohort",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Cohort"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "cohort_id"}}}}
          ],
          "condition": {"VarNotEmpty": "cohort_id"}
        }
      },
      {
        "Query": {
          "name": "link",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Student"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "student_id"}}}},
            {"AddE": {"label": "IN_COHORT", "to": {"Var": "new_cohort"}, "properties": []}}
          ],
          "condition": {"VarNotEmpty": "cohort_id"}
        }
      }
    ],
    "returns": ["student"]
  },
  "parameters": {
    "student_id": "",
    "display_name": "",
    "password_hash": "",
    "cohort_id": ""
  },
  "parameter_types": {
    "student_id": "String",
    "display_name": "String",
    "password_hash": "String",
    "cohort_id": "String"
  }
}
