{
  "request_type": "write",
  "query": {
    "queries": [
      {
        "Query": {
          "name": "student",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Student"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "student_id"}}}}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "old_cohort",
          "steps": [
            {"N": {"Var": "student"}},
            {"Out": "IN_COHORT"}
          ],
          "condition": {"VarNotEmpty": "student"}
        }
      },
      {
        "Query": {
          "name": "drop_old",
          "steps": [
            {"N": {"Var": "student"}},
            {"DropEdgeLabeled": {"to": {"Var": "old_cohort"}, "label": "IN_COHORT"}}
          ],
          "condition": {"VarNotEmpty": "old_cohort"}
        }
      },
      {
        "Query": {
          "name": "new_cohort",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Cohort"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "cohort_id"}}}}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "link",
          "steps": [
            {"N": {"Var": "student"}},
            {"AddE": {
              "label": "IN_COHORT",
              "to": {"Var": "new_cohort"},
              "properties": []
            }}
          ],
          "condition": {"VarNotEmpty": "new_cohort"}
        }
      }
    ],
    "returns": ["student"]
  },
  "parameters": {
    "student_id": "",
    "cohort_id": ""
  },
  "parameter_types": {
    "student_id": "String",
    "cohort_id": "String"
  }
}
