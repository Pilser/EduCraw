{
  "request_type": "write",
  "query": {
    "queries": [
      {
        "Query": {
          "name": "usage",
          "steps": [
            {"AddN": {
              "label": "TokenUsage",
              "properties": [
                ["student_id", {"Expr": {"Param": "student_id"}}],
                ["session_id", {"Expr": {"Param": "session_id"}}],
                ["model", {"Expr": {"Param": "model"}}],
                ["input_tokens", {"Expr": {"Param": "input_tokens"}}],
                ["output_tokens", {"Expr": {"Param": "output_tokens"}}],
                ["cache_creation_tokens", {"Expr": {"Param": "cache_creation_tokens"}}],
                ["cache_read_tokens", {"Expr": {"Param": "cache_read_tokens"}}]
              ]
            }}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "session_node",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Session"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "session_id"}}}}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "link_session",
          "steps": [
            {"N": {"Var": "session_node"}},
            {"AddE": {
              "label": "HAS_USAGE",
              "to": {"Var": "usage"},
              "properties": []
            }}
          ],
          "condition": {"VarNotEmpty": "session_node"}
        }
      },
      {
        "Query": {
          "name": "student_node",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Student"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "student_id"}}}}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "link_student",
          "steps": [
            {"N": {"Var": "student_node"}},
            {"AddE": {
              "label": "HAS_TOKEN_USAGE",
              "to": {"Var": "usage"},
              "properties": []
            }}
          ],
          "condition": {"VarNotEmpty": "student_node"}
        }
      }
    ],
    "returns": ["usage"]
  },
  "parameters": {
    "student_id": "",
    "session_id": "",
    "model": "",
    "input_tokens": 0,
    "output_tokens": 0,
    "cache_creation_tokens": 0,
    "cache_read_tokens": 0
  },
  "parameter_types": {
    "student_id": "String",
    "session_id": "String",
    "model": "String",
    "input_tokens": "I64",
    "output_tokens": "I64",
    "cache_creation_tokens": "I64",
    "cache_read_tokens": "I64"
  }
}
