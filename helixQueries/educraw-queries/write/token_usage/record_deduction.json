{
  "request_type": "write",
  "query": {
    "queries": [
      {
        "Query": {
          "name": "deduction",
          "steps": [
            {"AddN": {
              "label": "TokenDeduction",
              "properties": [
                ["student_id", {"Expr": {"Param": "student_id"}}],
                ["session_id", {"Expr": {"Param": "session_id"}}],
                ["model_name", {"Expr": {"Param": "model_name"}}],
                ["input_multiplier", {"Expr": {"Param": "input_multiplier"}}],
                ["output_multiplier", {"Expr": {"Param": "output_multiplier"}}],
                ["input_tokens_used", {"Expr": {"Param": "input_tokens_used"}}],
                ["output_tokens_used", {"Expr": {"Param": "output_tokens_used"}}],
                ["input_tokens_deducted", {"Expr": {"Param": "input_tokens_deducted"}}],
                ["output_tokens_deducted", {"Expr": {"Param": "output_tokens_deducted"}}],
                ["tokens_used", {"Expr": {"Param": "tokens_used"}}],
                ["tokens_deducted", {"Expr": {"Param": "tokens_deducted"}}],
                ["balance_before", {"Expr": {"Param": "balance_before"}}],
                ["balance_after", {"Expr": {"Param": "balance_after"}}],
                ["recorded_at", {"Expr": {"Param": "recorded_at"}}]
              ]
            }}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "student_node",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Student"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "student_id"}}}}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "link_student",
          "steps": [
            {"N": {"Var": "student_node"}},
            {"AddE": {
              "label": "HAS_DEDUCTION",
              "to": {"Var": "deduction"},
              "properties": []
            }}
          ],
          "condition": {"VarNotEmpty": "student_node"}
        }
      },
      {
        "Query": {
          "name": "session_node",
          "steps": [
            {"NWhere": {"Eq": ["$label", {"String": "Session"}]}},
            {"Where": {"Compare": {"left": {"Property": "id"}, "op": "Eq", "right": {"Param": "session_id"}}}}
          ],
          "condition": null
        }
      },
      {
        "Query": {
          "name": "link_session",
          "steps": [
            {"N": {"Var": "deduction"}},
            {"AddE": {
              "label": "OF_SESSION",
              "to": {"Var": "session_node"},
              "properties": []
            }}
          ],
          "condition": {"VarNotEmpty": "session_node"}
        }
      }
    ],
    "returns": ["deduction"]
  },
  "parameters": {
    "student_id": "",
    "session_id": "",
    "model_name": "",
    "input_multiplier": 1.0,
    "output_multiplier": 1.0,
    "input_tokens_used": 0,
    "output_tokens_used": 0,
    "input_tokens_deducted": 0,
    "output_tokens_deducted": 0,
    "tokens_used": 0,
    "tokens_deducted": 0,
    "balance_before": 0,
    "balance_after": 0,
    "recorded_at": ""
  },
  "parameter_types": {
    "student_id": "String",
    "session_id": "String",
    "model_name": "String",
    "input_multiplier": "F64",
    "output_multiplier": "F64",
    "input_tokens_used": "I64",
    "output_tokens_used": "I64",
    "input_tokens_deducted": "I64",
    "output_tokens_deducted": "I64",
    "tokens_used": "I64",
    "tokens_deducted": "I64",
    "balance_before": "I64",
    "balance_after": "I64",
    "recorded_at": "String"
  }
}
